// backend/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Basic player info
  name     String
  position String
  team     String?
  
  // Rankings and projections
  rank            Int?
  customRank      Int?
  positionalRank  String?      // Added missing field
  projectedPoints Float?
  vorp            Float?
  adp             Float?
  byeWeek         Int?
  lastSeasonPoints Float?      // Added missing field
  
  // Sleeper integration
  sleeperId   String?  @unique
  dataSource  String   @default("sleeper") // "sleeper", "excel", "manual"
  lastSyncAt  DateTime?
  
  // Draft status
  isDrafted Boolean @default(false)
  
  // Relationships
  tierId String?
  tier   Tier?   @relation(fields: [tierId], references: [id])
  
  playerTags PlayerTag[]
  notes      Note[]
  
  // Additional fields
  aliases                String[]
  depthChartPosition     String?
  depthChartOrder        Int?
  
  // Import tracking
  importSessionId String?

  @@map("players")
}

model ImportSession {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  summary    Json
  changes    Json
  rolledBack Boolean  @default(false)
  
  @@map("import_sessions")
}

model Tier {
  id    String @id @default(uuid())
  name  String @unique
  color String
  order Int    @unique

  players Player[]

  @@map("tiers")
}

model Tag {
  id    String @id @default(uuid())
  name  String @unique
  color String

  playerTags PlayerTag[]

  @@map("tags")
}

model PlayerTag {
  id       String @id @default(uuid())
  playerId String
  tagId    String

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([playerId, tagId])
  @@map("player_tags")
}

model Note {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  content  String
  color    String   @default("#6B7280")
  playerId String

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("notes")
}